# copy to .env and fill in. every value here ends up in the browser bundle, so nothing secret belongs in it.
# the url and anon key come from the supabase stack on the vm: grep '^ANON_KEY=' ~/supabase/docker/.env
VITE_SUPABASE_URL=http://192.168.1.118:8000
VITE_SUPABASE_ANON_KEY=
# the account that sees the admin buttons (imported, pull anyone's request)
VITE_ADMIN_EMAIL=
